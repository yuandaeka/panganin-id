        <!-- CHATBOT WIDGET SLIDE-UP PANEL -->
        <div id="ai-chatbot-panel" class="hidden absolute inset-x-0 bottom-0 top-1/4 bg-white rounded-t-3xl shadow-2xl z-50 flex flex-col border-t border-slate-200 transition-all-300">
            <!-- Header panel -->
            <div class="bg-gradient-to-r from-emerald-800 to-emerald-950 text-white px-4 py-3.5 rounded-t-3xl flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 bg-emerald-700 rounded-full flex items-center justify-center border border-emerald-600 shadow-sm">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h3 class="text-xs font-extrabold">Panganin AI Assistant</h3>
                        <p class="text-[9px] text-emerald-300 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-ping"></span> Ahli Gizi & HACCP Pintar</p>
                    </div>
                </div>
                <button onclick="toggleAIChatbot()" class="p-1.5 text-emerald-200 hover:text-white transition-all-300">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Messages Stream container -->
            <div id="chat-messages-container" class="flex-1 p-4 overflow-y-auto space-y-3.5 bg-slate-50">
                <!-- Message 1 (AI Welcome) -->
                <div class="flex items-start gap-2 max-w-[85%]">
                    <div class="w-6.5 h-6.5 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center text-[10px] p-1.5">AI</div>
                    <div class="bg-white border border-slate-100 p-3 rounded-2xl rounded-tl-none shadow-sm">
                        <p class="text-xs text-slate-800 leading-relaxed">Halo Chef! Saya **Panganin AI**. Saya siap membantu menjawab pertanyaan seputar standardisasi gizi, porsi makan besar, bahaya wadah (plastik/styrofoam), regulasi suhu, dan pengolahan limbah. Apa yang ingin Anda tanyakan hari ini?</p>
                    </div>
                </div>

                <!-- Chat helper suggestions buttons -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                    <button onclick="sendPredefinedQuery('Bagaimana agar kuah sup porsi besar tidak cepat dingin?')" class="text-[10px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-1.5 rounded-full border border-emerald-200 transition-all-300">
                        🍲 Sup massal tetap hangat?
                    </button>
                    <button onclick="sendPredefinedQuery('Apa bahaya membungkus makanan panas dengan plastik kresek?')" class="text-[10px] bg-red-50 hover:bg-red-100 text-red-800 font-semibold px-2.5 py-1.5 rounded-full border border-red-200 transition-all-300">
                        ⚠️ Bahaya bungkus kresek?
                    </button>
                    <button onclick="sendPredefinedQuery('Bagaimana sistem blockchain membantu petani lokal?')" class="text-[10px] bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold px-2.5 py-1.5 rounded-full border border-amber-200 transition-all-300">
                        🔗 Peran Blockchain tani?
                    </button>
                </div>
            </div>

            <!-- Chat input controls -->
            <div class="p-3 bg-white border-t border-slate-100 flex gap-2">
                <input type="text" id="chat-user-input" placeholder="Ketik pertanyaan gizi/HACCP..." class="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-600 transition-all-300" onkeypress="handleChatEnter(event)">
                <button onclick="sendMessageFromInput()" class="bg-emerald-600 hover:bg-emerald-700 text-white p-3 rounded-xl shadow-md shadow-emerald-600/10 transition-all-300">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
