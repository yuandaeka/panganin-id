    </main>

    <!-- FOOTER / CREDIT OUTSIDE SIMULATOR VIEWPORT -->
    <footer class="bg-slate-900 border-t border-slate-800 text-slate-500 py-6 text-center text-xs mt-auto">
        <p class="font-bold text-slate-400">PANGANIN © 2026</p>
        <p class="text-[10px] mt-1 max-w-md mx-auto px-4">Inovasi Ekosistem berbasis AI dan Blockchain untuk Ketahanan Pangan Sosial & Circular Economy.</p>
    </footer>

    <!-- JAVASCRIPT SYSTEM INTERACTIVITY -->
    <script>
        // Tab / Screen switching engine
        function switchTab(targetTab) {
            // Hide all screen sections
            document.getElementById('screen-home').classList.add('hidden');
            document.getElementById('screen-planner').classList.add('hidden');
            document.getElementById('screen-haccp').classList.add('hidden');
            document.getElementById('screen-blockchain').classList.add('hidden');
            document.getElementById('screen-waste').classList.add('hidden');

            // Show target screen
            document.getElementById('screen-' + targetTab).classList.remove('hidden');

            // Reset navigation button visual states
            const navButtons = ['home', 'planner', 'haccp', 'blockchain'];
            navButtons.forEach(btn => {
                const element = document.getElementById('nav-btn-' + btn);
                if (element) {
                    element.classList.remove('text-emerald-500');
                    element.classList.add('text-slate-400');
                }
            });

            // Activate current nav button highlight
            const targetBtn = document.getElementById('nav-btn-' + targetTab);
            if (targetBtn) {
                targetBtn.classList.remove('text-slate-400');
                targetBtn.classList.add('text-emerald-500');
            }

            // Close chatbot when switching screens
            document.getElementById('ai-chatbot-panel').classList.add('hidden');

            // Run special screen setup
            if (targetTab === 'planner') {
                calculatePortion();
            }
        }

        // Floating AI chatbot panel toggle state manager
        function toggleAIChatbot() {
            const chatbotPanel = document.getElementById('ai-chatbot-panel');
            chatbotPanel.classList.toggle('hidden');
            
            // Scroll to bottom of chat
            const chatContainer = document.getElementById('chat-messages-container');
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        // Global Alert Notifications
        function toggleGlobalNotification() {
            const toast = document.getElementById('notification-toast');
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 6000);
        }

        function toggleCustomDishInput() {
            const select = document.getElementById('planner-dish-select');
            const customContainer = document.getElementById('custom-dish-input-container');
            if (select.value === 'custom') {
                customContainer.classList.remove('hidden');
                const customInput = document.getElementById('planner-custom-dish');
                if (!customInput.value.trim()) {
                    customInput.value = "Nasi Rendang Sapi & Melon";
                }
            } else {
                customContainer.classList.add('hidden');
            }
        }

        // Recipe Portion Planner engine
        function updatePortionSlider(value) {
            document.getElementById('portion-value-display').innerText = parseInt(value).toLocaleString() + " Porsi";
            calculatePortion();
        }

        function calculatePortion() {
            const dish = document.getElementById('planner-dish-select').value;
            const customDishText = document.getElementById('planner-custom-dish').value.trim() || "Hidangan Kustom";
            const portionCount = parseInt(document.getElementById('portion-range').value);
            const budgetOptimizer = document.getElementById('budget-toggle').checked;
            
            const ingredientsContainer = document.getElementById('ingredients-container');
            const aiBadge = document.getElementById('ai-badge-status');
            let ingredients = [];
            let pricePerPortion = 15000; // Base rupiah per portion

            if (budgetOptimizer) {
                pricePerPortion = 12000; // Discounted due to AI farmer matchmaking and direct buy
            }

            // Show temporary animated generating state for visual effect
            if (aiBadge) {
                aiBadge.innerHTML = `
                    <span class="bg-amber-100 text-amber-800 text-[9px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1 animate-pulse">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> AI Generating...
                    </span>
                    <span class="text-[10px] text-emerald-700 font-bold flex items-center gap-1"><i class="fa-solid fa-shield-halved"></i> Gizi Seimbang</span>
                `;
            }

            if (dish === 'capcay') {
                ingredients = [
                    { name: 'Beras Lokal (Boyolali)', weight: 0.1 * portionCount, unit: 'Kg', icon: 'wheat-awn' },
                    { name: 'Daging Ayam Karanganyar', weight: 0.08 * portionCount, unit: 'Kg', icon: 'egg' },
                    { name: 'Bawang Merah & Putih Petani', weight: 0.015 * portionCount, unit: 'Kg', icon: 'pepper-hot' },
                    { name: 'Wortel & Sayuran Hijau Segar', weight: 0.12 * portionCount, unit: 'Kg', icon: 'seedling' },
                    { name: 'Apel Malang Grade B (Surplus)', weight: 1 * portionCount, unit: 'Pcs', icon: 'apple-whole' },
                ];
            } else if (dish === 'taco') {
                ingredients = [
                    { name: 'Daging Karkas Ayam Potong', weight: 0.1 * portionCount, unit: 'Kg', icon: 'egg' },
                    { name: 'Selada & Kubis Organik', weight: 0.15 * portionCount, unit: 'Kg', icon: 'seedling' },
                    { name: 'Minyak Kelapa Sawit Curah', weight: 0.02 * portionCount, unit: 'Liter', icon: 'droplet' },
                    { name: 'Jeruk Manis Karanganyar', weight: 1 * portionCount, unit: 'Pcs', icon: 'lemon' },
                ];
            } else if (dish === 'seblak') { // Soto
                ingredients = [
                    { name: 'Bihun Jagung Sehat', weight: 0.08 * portionCount, unit: 'Kg', icon: 'wheat-awn' },
                    { name: 'Suwiran Daging Ayam', weight: 0.06 * portionCount, unit: 'Kg', icon: 'egg' },
                    { name: 'Bawang Putih, Kunyit & Rempah', weight: 0.02 * portionCount, unit: 'Kg', icon: 'leaf' },
                    { name: 'Pisang Mas Solo Raya', weight: 1 * portionCount, unit: 'Pcs', icon: 'apple-whole' },
                ];
            } else if (dish === 'custom') {
                // Dynamically build recipe based on user input keywords
                const lowerCustom = customDishText.toLowerCase();
                let mainProtein = "Protein Utama Pilihan AI";
                let proteinIcon = "egg";
                let mainCarb = "Karbohidrat Pokok Pilihan AI";
                let carbIcon = "wheat-awn";
                let mainVeg = "Sayuran & Bumbu Pelengkap AI";
                let vegIcon = "seedling";
                let mainFruit = "Buah Gizi Pendamping AI";
                let fruitIcon = "apple-whole";

                if (lowerCustom.includes("rendang") || lowerCustom.includes("sapi") || lowerCustom.includes("daging")) {
                    mainProtein = "Daging Sapi Lokal (Boyolali)";
                    proteinIcon = "cow";
                    mainCarb = "Beras Organik Sragen";
                    mainVeg = "Rempah Rendang & Santan Kelapa";
                    vegIcon = "pepper-hot";
                } else if (lowerCustom.includes("ikan") || lowerCustom.includes("lele") || lowerCustom.includes("nila")) {
                    mainProtein = "Ikan Segar Budidaya Mina Tani";
                    proteinIcon = "fish";
                    mainCarb = "Nasi Putih Premium";
                } else if (lowerCustom.includes("goreng") || lowerCustom.includes("mie") || lowerCustom.includes("nasi")) {
                    mainCarb = "Beras/Mie Telur Pilihan";
                    mainProtein = "Telur & Suwiran Ayam";
                }

                if (lowerCustom.includes("pisang")) {
                    mainFruit = "Pisang Mas Solo Raya";
                } else if (lowerCustom.includes("semangka")) {
                    mainFruit = "Semangka Merah Segar";
                } else if (lowerCustom.includes("jeruk")) {
                    mainFruit = "Jeruk Manis Karanganyar";
                    fruitIcon = "lemon";
                } else if (lowerCustom.includes("melon")) {
                    mainFruit = "Melon Madu Grade A";
                }

                ingredients = [
                    { name: mainCarb, weight: 0.09 * portionCount, unit: 'Kg', icon: carbIcon },
                    { name: mainProtein, weight: 0.07 * portionCount, unit: 'Kg', icon: proteinIcon },
                    { name: mainVeg, weight: 0.11 * portionCount, unit: 'Kg', icon: vegIcon },
                    { name: mainFruit, weight: 1 * portionCount, unit: 'Pcs', icon: fruitIcon }
                ];
            }

            // Print ingredients output cards dynamically after a slight delay to simulate calculation
            setTimeout(() => {
                ingredientsContainer.innerHTML = '';
                ingredients.forEach(ing => {
                    const card = document.createElement('div');
                    card.className = "flex items-center justify-between p-2.5 bg-slate-50 border border-slate-100 rounded-xl text-xs";
                    card.innerHTML = `
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 bg-emerald-100 text-emerald-800 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-${ing.icon}"></i>
                            </div>
                            <span class="font-bold text-slate-800">${ing.name}</span>
                        </div>
                        <span class="font-extrabold text-slate-500 bg-white border px-2 py-1 rounded-lg">${ing.weight.toLocaleString(undefined, {maximumFractionDigits: 1})} ${ing.unit}</span>
                    `;
                    ingredientsContainer.appendChild(card);
                });

                // Update badge to verified AI Generated state
                if (aiBadge) {
                    aiBadge.innerHTML = `
                        <span class="bg-emerald-100 text-emerald-800 text-[9px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles text-emerald-600"></i> AI Generated
                        </span>
                        <span class="text-[10px] text-emerald-700 font-bold flex items-center gap-1"><i class="fa-solid fa-shield-halved"></i> Gizi Seimbang</span>
                    `;
                }
            }, 300);

            // Calculate total price with verified indicator
            const totalPrice = pricePerPortion * portionCount;
            document.getElementById('total-price-display').innerHTML = `
                Rp ${totalPrice.toLocaleString()} 
                <span class="text-[9px] bg-emerald-100 text-emerald-800 font-extrabold px-1.5 py-0.5 rounded-full ml-1"><i class="fa-solid fa-link"></i> BC Verified</span>
            `;
        }

        function matchFarmersDirectly() {
            switchTab('blockchain');
        }

        // Simulated AI HACCP camera scanner logic
        function simulateHACCP(preset) {
            const camImg = document.getElementById('haccp-camera-img');
            const placeholder = document.getElementById('haccp-placeholder-text');
            const resultDetails = document.getElementById('haccp-result-details');
            const boxDanger = document.getElementById('haccp-bounding-box');
            const boxSafe = document.getElementById('haccp-bounding-box-safe');

            const scoreText = document.getElementById('haccp-score');
            const verdictTitle = document.getElementById('haccp-verdict-title');
            const verdictDesc = document.getElementById('haccp-verdict-desc');
            const categorySpan = document.getElementById('haccp-category-span');
            const tempSpan = document.getElementById('haccp-temp-span');
            const packagingSpan = document.getElementById('haccp-packaging-span');
            const adviceBox = document.getElementById('haccp-advice-box');
            const indicatorIcon = document.getElementById('haccp-indicator-icon');

            placeholder.classList.add('hidden');
            resultDetails.classList.remove('hidden');

            boxDanger.classList.add('hidden');
            boxSafe.classList.add('hidden');

            if (preset === 'styrofoam') {
                camImg.src = "https://placehold.co/600x350/ffe4e6/991b1b?text=Wadah+Sup+Styrofoam+Terbuka";
                boxDanger.classList.remove('hidden');
                document.getElementById('haccp-bounding-tag').innerText = "BAHAYA: STYROFOAM DETECTED";

                scoreText.innerText = "42/100";
                scoreText.className = "text-sm font-black text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full";

                verdictTitle.innerText = "Peringatan Kontaminasi Wadah!";
                verdictDesc.innerText = "Styrofoam memicu pelepasan bahan berbahaya stirena saat terkena kuah sup bersuhu tinggi (>70°C).";
                
                categorySpan.innerText = "Wadah / Kemasan Distribusi";
                tempSpan.innerText = "85°C (Terlalu Panas)";
                packagingSpan.innerText = "Styrofoam (Dilarang)";

                indicatorIcon.className = "w-7 h-7 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs mt-0.5";
                indicatorIcon.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i>`;

                adviceBox.className = "p-3 rounded-2xl text-xs space-y-1 bg-red-50 text-red-900 border border-red-100";
                adviceBox.innerHTML = `
                    <p class="font-bold">Rekomendasi Tindakan Segera:</p>
                    <p>Hentikan pembagian makanan! Pindahkan sup kuah panas ke wadah plastik kode 5 (PP) atau stainless steel bersertifikasi foodgrade.</p>
                `;

            } else if (preset === 'plastic') {
                camImg.src = "https://placehold.co/600x350/ffe4e6/991b1b?text=Makanan+Panas+Bungkus+Kresek";
                boxDanger.classList.remove('hidden');
                document.getElementById('haccp-bounding-tag').innerText = "RISIKO: PLASTIK KRESEK HITAM";

                scoreText.innerText = "35/100";
                scoreText.className = "text-sm font-black text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full";

                verdictTitle.innerText = "Bahaya Kresek Daur Ulang!";
                verdictDesc.innerText = "Plastik kresek hitam terbuat dari daur ulang polimer yang mengandung klorin, berbahaya saat bersentuhan dengan makanan berlemak dan panas.";
                
                categorySpan.innerText = "Kebersihan & Penyajian";
                tempSpan.innerText = "78°C (Berbahaya)";
                packagingSpan.innerText = "Kresek Hitam Daur Ulang";

                indicatorIcon.className = "w-7 h-7 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs mt-0.5";
                indicatorIcon.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i>`;

                adviceBox.className = "p-3 rounded-2xl text-xs space-y-1 bg-red-50 text-red-900 border border-red-100";
                adviceBox.innerHTML = `
                    <p class="font-bold">Rekomendasi Tindakan Segera:</p>
                    <p>Gunakan wadah kertas berlapisan lilin foodgrade atau kemasan kotak biodegradabel berbahan serat tebu/singkong.</p>
                `;

            } else if (preset === 'stainless') {
                camImg.src = "https://placehold.co/600x350/ecfdf5/065f46?text=Stainless+Steel+Wadah+Saji";
                boxSafe.classList.remove('hidden');
                document.getElementById('haccp-bounding-tag-safe').innerText = "AMAN: FOOD GRADE STAINLESS";

                scoreText.innerText = "98/100";
                scoreText.className = "text-sm font-black text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full";

                verdictTitle.innerText = "Sangat Higienis & Aman";
                verdictDesc.innerText = "Wadah stainless steel meminimalkan risiko perpindahan partikel kimia dan mudah disterilkan secara masif.";
                
                categorySpan.innerText = "Material Serving Dapur";
                tempSpan.innerText = "65°C (Suhu Hangat Ideal)";
                packagingSpan.innerText = "SUS 304 Foodgrade";

                indicatorIcon.className = "w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs mt-0.5";
                indicatorIcon.innerHTML = `<i class="fa-solid fa-circle-check"></i>`;

                adviceBox.className = "p-3 rounded-2xl text-xs space-y-1 bg-emerald-50 text-emerald-900 border border-emerald-100";
                adviceBox.innerHTML = `
                    <p class="font-bold">Status Verifikasi:</p>
                    <p>Sangat direkomendasikan untuk pendistribusian makanan Program Makan Bergizi Gratis skala besar.</p>
                `;

            } else if (preset === 'dirty') {
                camImg.src = "https://placehold.co/600x350/fffbeb/92400e?text=Dapur+Meja+Saji+Kotor";
                boxDanger.classList.remove('hidden');
                document.getElementById('haccp-bounding-tag').innerText = "PERINGATAN: KOTOR & KONTAMINASI";

                scoreText.innerText = "55/100";
                scoreText.className = "text-sm font-black text-amber-600 bg-amber-50 px-2.5 py-0.5 rounded-full";

                verdictTitle.innerText = "Kebersihan Meja Kurang";
                verdictDesc.innerText = "Ditemukan sisa bahan makanan kotor di dekat area pengemasan akhir, berpotensi mengundang lalat dan kontaminasi bakteri.";
                
                categorySpan.innerText = "Kebersihan Area Produksi";
                tempSpan.innerText = "28°C (Suhu Ruang)";
                packagingSpan.innerText = "Stainless Meja Kotor";

                indicatorIcon.className = "w-7 h-7 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xs mt-0.5";
                indicatorIcon.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i>`;

                adviceBox.className = "p-3 rounded-2xl text-xs space-y-1 bg-amber-50 text-amber-900 border border-amber-100";
                adviceBox.innerHTML = `
                    <p class="font-bold">Rekomendasi Tindakan Segera:</p>
                    <p>Bersihkan meja produksi dengan larutan disinfektan klorin 100ppm sebelum memulai proses pengemasan menu selanjutnya.</p>
                `;
            }
        }

        // Circular Food waste recording logic
        function submitWasteToBlockchain() {
            const weightInput = document.getElementById('waste-weight-input').value;
            if (!weightInput || parseFloat(weightInput) <= 0) {
                alert("Silakan masukkan berat limbah yang valid!");
                return;
            }

            const weight = parseFloat(weightInput);
            const partnerSelect = document.getElementById('waste-partner-select');
            const partnerText = partnerSelect.options[partnerSelect.selectedIndex].text;

            // Trigger Blockchain notification
            const toast = document.getElementById('notification-toast');
            toast.querySelector('p.text-xs').innerText = `Limbah ${weight} Kg Terdaftarkan di Blockchain`;
            toast.querySelector('p.text-[10px]').innerText = `Berhasil disalurkan ke: ${partnerText}.`;
            toast.classList.remove('hidden');

            // Dynamically update impacts stats
            const totalWeightElem = document.getElementById('circular-total-weight');
            const totalPointsElem = document.getElementById('circular-total-points');

            const currentWeight = parseFloat(totalWeightElem.innerText);
            const currentPoints = parseInt(totalPointsElem.innerText.replace(/,/g, ''));

            const newWeight = currentWeight + weight;
            const newPoints = currentPoints + (weight * 10); // 1kg = 10 Eco Poin

            totalWeightElem.innerText = newWeight + " Kg";
            totalPointsElem.innerText = newPoints.toLocaleString() + " Poin";

            // Reset Input
            document.getElementById('waste-weight-input').value = '';

            // Auto switch to home screen to show transaction notification
            setTimeout(() => {
                switchTab('home');
                toast.classList.add('hidden');
            }, 3000);
        }

        // Interactive PANGANIN AI Chatbot simulator
        function handleChatEnter(event) {
            if (event.key === 'Enter') {
                sendMessageFromInput();
            }
        }

        function sendMessageFromInput() {
            const input = document.getElementById('chat-user-input');
            const query = input.value.trim();
            if (!query) return;

            renderUserChatMessage(query);
            input.value = '';

            // Generate AI response
            setTimeout(() => {
                getAIResponse(query);
            }, 1000);
        }

        function sendPredefinedQuery(query) {
            renderUserChatMessage(query);
            setTimeout(() => {
                getAIResponse(query);
            }, 1000);
        }

        function renderUserChatMessage(text) {
            const container = document.getElementById('chat-messages-container');
            const messageDiv = document.createElement('div');
            messageDiv.className = "flex items-start gap-2 max-w-[85%] ml-auto justify-end";
            messageDiv.innerHTML = `
                <div class="bg-emerald-600 text-white p-3 rounded-2xl rounded-tr-none shadow-sm text-xs">
                    <p class="leading-relaxed">${text}</p>
                </div>
                <div class="w-6.5 h-6.5 bg-emerald-700 text-white rounded-full flex items-center justify-center text-[10px] p-1.5 font-bold">ME</div>
            `;
            container.appendChild(messageDiv);
            container.scrollTop = container.scrollHeight;
        }

        function getAIResponse(query) {
            const container = document.getElementById('chat-messages-container');
            const messageDiv = document.createElement('div');
            messageDiv.className = "flex items-start gap-2 max-w-[85%]";
            
            let reply = "";
            const lowerQuery = query.toLowerCase();

            if (lowerQuery.includes('dingin') || lowerQuery.includes('masak')) {
                reply = "Untuk menghindari makanan dingin pada program porsi besar (seperti kritik masukan Wapres Gibran): \n\n1. **Prinsip T-T-T (Time, Temp, Trade)**: Jeda waktu antara selesai masak & distribusi tidak boleh lebih dari 4 jam jika tanpa pemanas. \n2. **Gunakan Thermal Insulated Box**: Simpan wadah stainless dalam kotak berisolasi busa poliuretan tebal agar suhu bertahan di atas 60°C.";
            } else if (lowerQuery.includes('plastik') || lowerQuery.includes('kresek') || lowerQuery.includes('styrofoam') || lowerQuery.includes('wadah')) {
                reply = "Wadah non-foodgrade sangat berbahaya bagi kesehatan!\n\n* **Plastik Kresek Hitam**: Hasil daur ulang kotor. Panas memicu perpindahan logam berat & klorin.\n* **Styrofoam**: Mengandung zat residu karsinogenik (Benzena/Stirena). Sangat dilarang untuk kuah bersuhu >70°C.\n* **Rekomendasi**: Gunakan wadah plastik PP (Kode 5) atau kemasan serat tanaman (bagasse) biodegradable yang aman.";
            } else if (lowerQuery.includes('blockchain') || lowerQuery.includes('tani') || lowerQuery.includes('petani')) {
                reply = "Sistem **PANGANIN Blockchain** mencatat data pasokan pangan langsung dari petani lokal tanpa perantara tengkulak. \n\nKeuntungannya: \n1. **Transparansi Harga**: Memastikan harga beli transparan di ledger digital guna mencegah korupsi atau manipulasi anggaran program gizi.\n2. **Rantai Pasok Kilat**: Menghubungkan logistik terdekat sehingga makanan lebih segar saat sampai ke dapur massal.";
            } else if (lowerQuery.includes('haccp')) {
                reply = "Analisis **HACCP (Hazard Analysis Critical Control Point)** di Panganin melacak kebersihan dapur Anda. Anda bisa memoto meja produksi atau wadah penyajian, dan AI kami akan mengukur skor higienitas, potensi cemaran mikroba silang, serta memberikan checklist digital secara otomatis.";
            } else {
                reply = "Terima kasih atas pertanyaannya! Saya dapat memandu Anda untuk optimasi resep massal bergizi, mendeteksi bahaya wadah saji (styrofoam/kresek) dengan AI scanner, serta pencocokan petani lokal via blockchain. Silakan ketik pertanyaan yang lebih spesifik.";
            }

            // Convert raw bullets to html layout
            const formattedReply = reply.replace(/\n/g, '<br>');

            messageDiv.innerHTML = `
                <div class="w-6.5 h-6.5 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center text-[10px] p-1.5">AI</div>
                <div class="bg-white border border-slate-100 p-3 rounded-2xl rounded-tl-none shadow-sm text-xs">
                    <p class="leading-relaxed text-slate-800">${formattedReply}</p>
                </div>
            `;
            container.appendChild(messageDiv);
            container.scrollTop = container.scrollHeight;
        }

        // Initialize default app state
        window.onload = function() {
            calculatePortion();
        };
    </script>
</body>
</html>