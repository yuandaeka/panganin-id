<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PANGANIN - Ekosistem Pangan Sosial berbasis AI & Blockchain</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emerald: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        },
                        amber: {
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        /* Smooth transitions */
        .transition-all-300 {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-40 w-full transition-all-300">
        <div class="max-w-md mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-10 h-10 bg-emerald-50 rounded-full flex items-center justify-center border border-emerald-100">
                    <i class="fa-solid fa-leaf text-emerald-600 text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold tracking-tight text-emerald-800 flex items-center gap-1">
                        PANGANIN <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded-full">AI & BC</span>
                    </h1>
                    <p class="text-[10px] text-slate-500 font-medium tracking-wide">PANGAN AMAN & TERINTEGRASI</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="toggleGlobalNotification()" class="relative p-2 text-slate-500 hover:text-emerald-600 transition-all-300 rounded-full hover:bg-slate-50">
                    <i class="fa-solid fa-bell text-lg"></i>
                    <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full ring-2 ring-white"></span>
                </button>
                <div class="w-8 h-8 rounded-full bg-emerald-700 text-white font-bold flex items-center justify-center text-xs overflow-hidden shadow-sm">
                    CA
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN INTERACTIVE HUB (Restricted to Max-Width for Mobile First Experience, Scales on Desktop) -->
    <main class="flex-1 max-w-md mx-auto w-full bg-white shadow-xl shadow-slate-100 flex flex-col pb-24 min-h-[calc(100vh-65px)] relative overflow-x-hidden">
        
        <!-- Notification Banner Toast -->
        <div id="notification-toast" class="hidden bg-emerald-800 text-white p-3 mx-4 mt-3 rounded-2xl flex items-start gap-2.5 shadow-lg animate-bounce">
            <i class="fa-solid fa-circle-check text-emerald-300 mt-1"></i>
            <div class="flex-1">
                <p class="text-xs font-semibold">Transaksi Blockchain Terverifikasi</p>
                <p class="text-[10px] text-emerald-100">Sisa limbah organik berhasil disalurkan ke CV EcoEnzym Surakarta.</p>
            </div>
            <button onclick="document.getElementById('notification-toast').classList.add('hidden')" class="text-emerald-200 hover:text-white">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- APP CONTENT ROOT SCREENS -->
        
        <!-- SCREEN 1: HOME (ACTIVE BY DEFAULT) -->
        <section id="screen-home" class="p-4 space-y-5">
            <!-- Greeting & Header -->
            <div class="space-y-1">
                <h2 class="text-2xl font-black text-slate-800 tracking-tight">Hello Chef Amir!</h2>
                <p class="text-sm text-slate-500 font-medium">Ready to cook nutritious, safe, and clean meals today?</p>
                <div class="flex flex-wrap gap-1.5 pt-1">
                    <span class="text-[10px] bg-emerald-50 text-emerald-700 font-bold px-2 py-0.5 rounded-full border border-emerald-100"><i class="fa-solid fa-hotel mr-1"></i> Dapur MBG Solo</span>
                    <span class="text-[10px] bg-amber-50 text-amber-700 font-bold px-2 py-0.5 rounded-full border border-amber-100"><i class="fa-solid fa-certificate mr-1"></i> HACCP Certified</span>
                </div>
            </div>

            <!-- Global Search & Direct Query bar -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" placeholder="Cari resep porsi besar, petani lokal, info gizi..." class="w-full bg-slate-50 border border-slate-200/80 rounded-2xl py-3.5 pl-10 pr-4 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:bg-white transition-all-300">
            </div>

            <!-- PANGANIN Core Features Quick Access Grid -->
            <div>
                <h3 class="text-xs font-extrabold text-slate-400 tracking-wider uppercase mb-3">Layanan Utama Panganin</h3>
                <div class="grid grid-cols-2 gap-3">
                    <!-- Nav Card 1: AI Portion Planner -->
                    <button onclick="switchTab('planner')" class="flex flex-col text-left p-3.5 bg-emerald-50/60 hover:bg-emerald-50 border border-emerald-100/50 rounded-2xl transition-all-300 group">
                        <div class="w-10 h-10 bg-emerald-600 text-white rounded-xl flex items-center justify-center shadow-md shadow-emerald-200 mb-3 group-hover:scale-110 transition-all-300">
                            <i class="fa-solid fa-calculator text-lg"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-800 leading-tight">AI Portion Planner</span>
                        <span class="text-[10px] text-slate-500 mt-1">Estimasi porsi & resep massal</span>
                    </button>

                    <!-- Nav Card 2: AI HACCP Scanner -->
                    <button onclick="switchTab('haccp')" class="flex flex-col text-left p-3.5 bg-red-50/40 hover:bg-red-50 border border-red-100/50 rounded-2xl transition-all-300 group">
                        <div class="w-10 h-10 bg-red-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-red-200 mb-3 group-hover:scale-110 transition-all-300">
                            <i class="fa-solid fa-camera-retro text-lg"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-800 leading-tight">AI HACCP Scanner</span>
                        <span class="text-[10px] text-slate-500 mt-1">Audit kebersihan & wadah AI</span>
                    </button>

                    <!-- Nav Card 3: Blockchain Supply -->
                    <button onclick="switchTab('blockchain')" class="flex flex-col text-left p-3.5 bg-amber-50/40 hover:bg-amber-50 border border-amber-100/50 rounded-2xl transition-all-300 group">
                        <div class="w-10 h-10 bg-amber-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-amber-200 mb-3 group-hover:scale-110 transition-all-300">
                            <i class="fa-solid fa-cubes text-lg"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-800 leading-tight">Blockchain Supply</span>
                        <span class="text-[10px] text-slate-500 mt-1">Harga adil & rute tani lokal</span>
                    </button>

                    <!-- Nav Card 4: Waste to Value -->
                    <button onclick="switchTab('waste')" class="flex flex-col text-left p-3.5 bg-blue-50/40 hover:bg-blue-50 border border-blue-100/50 rounded-2xl transition-all-300 group">
                        <div class="w-10 h-10 bg-blue-500 text-white rounded-xl flex items-center justify-center shadow-md shadow-blue-200 mb-3 group-hover:scale-110 transition-all-300">
                            <i class="fa-solid fa-recycle text-lg"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-800 leading-tight">Waste to Value</span>
                        <span class="text-[10px] text-slate-500 mt-1">Distribusi pupuk & eco-enzyme</span>
                    </button>
                </div>
            </div>

            <!-- Today's MBG Menu & Quick Summary Section -->
            <div class="bg-gradient-to-br from-emerald-800 to-emerald-950 text-white rounded-3xl p-4 shadow-xl shadow-emerald-900/10 space-y-4">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="text-[9px] bg-emerald-700/80 text-emerald-200 font-extrabold px-2 py-0.5 rounded-full uppercase tracking-wider">Jadwal Menu Hari Ini</span>
                        <h4 class="text-lg font-extrabold mt-1">Nasi Ayam Capcay & Apel</h4>
                        <p class="text-[10px] text-emerald-300"><i class="fa-solid fa-clock mr-1"></i> Target Distribusi: 11:30 WIB (Makan Siang)</p>
                    </div>
                    <div class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center border border-white/20">
                        <i class="fa-solid fa-utensils text-emerald-200 text-lg"></i>
                    </div>
                </div>
                
                <div class="grid grid-cols-3 gap-2 text-center bg-white/5 p-2.5 rounded-2xl border border-white/10">
                    <div>
                        <span class="text-[9px] text-emerald-300 block">Kebutuhan Porsi</span>
                        <span class="text-sm font-bold block">1,000 porsi</span>
                    </div>
                    <div>
                        <span class="text-[9px] text-emerald-300 block">Status Bahan</span>
                        <span class="text-sm font-bold text-emerald-300 block"><i class="fa-solid fa-circle-check text-[10px] mr-1"></i>Ready</span>
                    </div>
                    <div>
                        <span class="text-[9px] text-emerald-300 block">Skor HACCP</span>
                        <span class="text-sm font-bold text-emerald-300 block">98/100</span>
                    </div>
                </div>

                <div class="flex gap-2">
                    <button onclick="switchTab('planner')" class="flex-1 bg-white hover:bg-emerald-50 text-emerald-900 text-xs font-bold py-2.5 px-4 rounded-xl transition-all-300 flex items-center justify-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-calculator"></i> Sesuaikan Porsi
                    </button>
                    <button onclick="switchTab('haccp')" class="flex-1 bg-emerald-700 hover:bg-emerald-600 text-white border border-emerald-600 text-xs font-bold py-2.5 px-4 rounded-xl transition-all-300 flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-camera"></i> Mulai Scan HACCP
                    </button>
                </div>
            </div>

            <!-- Global Nutrition News & Global Cooking Tips (Edukasi Global) -->
            <div>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-extrabold text-slate-400 tracking-wider uppercase">Edukasi Global & Berita Gizi</h3>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">Dunia & Lokal</span>
                </div>
                
                <!-- Horizontal scrolling news carousel -->
                <div class="flex gap-4 overflow-x-auto pb-2 snap-x scroll-smooth">
                    <!-- Slide 1 -->
                    <div class="flex-shrink-0 w-72 bg-white border border-slate-100 rounded-2xl p-3 snap-start shadow-sm space-y-2.5">
                        <div class="h-28 rounded-xl overflow-hidden relative">
                            <img src="https://placehold.co/400x200/047857/ffffff?text=Edukasi+Wadah+Food-Grade" alt="Edukasi Wadah" class="w-full h-full object-cover">
                            <span class="absolute top-2 left-2 bg-red-600 text-[9px] text-white font-extrabold px-1.5 py-0.5 rounded">BAHAYA KRESEK</span>
                        </div>
                        <div class="space-y-1">
                            <h4 class="text-xs font-extrabold text-slate-800 leading-snug">Bahaya Zat Kimia Wadah Non-Foodgrade</h4>
                            <p class="text-[10px] text-slate-500 line-clamp-2">Membungkus makanan panas (seperti seblak/warmindo) dengan plastik kresek hitam atau styrofoam memicu migrasi zat karsinogenik.</p>
                        </div>
                    </div>
                    
                    <!-- Slide 2 -->
                    <div class="flex-shrink-0 w-72 bg-white border border-slate-100 rounded-2xl p-3 snap-start shadow-sm space-y-2.5">
                        <div class="h-28 rounded-xl overflow-hidden relative">
                            <img src="https://placehold.co/400x200/d97706/ffffff?text=Tips+Masak+Porsi+Besar" alt="Tips Masak" class="w-full h-full object-cover">
                            <span class="absolute top-2 left-2 bg-amber-600 text-[9px] text-white font-extrabold px-1.5 py-0.5 rounded">TIPS MASAK MBG</span>
                        </div>
                        <div class="space-y-1">
                            <h4 class="text-xs font-extrabold text-slate-800 leading-snug">Cara Agar Porsi Besar Tidak Cepat Dingin</h4>
                            <p class="text-[10px] text-slate-500 line-clamp-2">Gibran menyoroti makanan dingin akibat dimasak terlalu pagi. Simak tips pembagian waktu produksi dan penggunaan alat isolasi suhu.</p>
                        </div>
                    </div>

                    <!-- Slide 3 -->
                    <div class="flex-shrink-0 w-72 bg-white border border-slate-100 rounded-2xl p-3 snap-start shadow-sm space-y-2.5">
                        <div class="h-28 rounded-xl overflow-hidden relative">
                            <img src="https://placehold.co/400x200/0369a1/ffffff?text=Sirkular+Ekonomi+Sampah" alt="Sirkular Sampah" class="w-full h-full object-cover">
                            <span class="absolute top-2 left-2 bg-blue-600 text-[9px] text-white font-extrabold px-1.5 py-0.5 rounded">ECO ENZYME</span>
                        </div>
                        <div class="space-y-1">
                            <h4 class="text-xs font-extrabold text-slate-800 leading-snug">Mengolah Sisa Dapur Menjadi Nilai Rupiah</h4>
                            <p class="text-[10px] text-slate-500 line-clamp-2">Menghubungkan sisa sayur dan buah dapur MBG langsung ke pabrik kompos mikro lokal via pelacakan blockchain terpercaya.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>


        <!-- SCREEN 2: AI PORTION PLANNER -->
        <section id="screen-planner" class="hidden p-4 space-y-5">
            <!-- Header -->
            <div class="flex items-center gap-2">
                <button onclick="switchTab('home')" class="p-2 bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-full transition-all-300">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div>
                    <h2 class="text-xl font-extrabold text-slate-800 leading-tight">AI Portion & Recipe Planner</h2>
                    <p class="text-xs text-slate-500">Hitung presisi bahan, nilai gizi, & minimalisasi food-waste</p>
                </div>
            </div>

            <!-- Input Card -->
            <div class="bg-white border border-slate-100 rounded-3xl p-4 shadow-sm space-y-4">
                <div class="space-y-2">
                    <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider block">1. Pilih Hidangan Utama</label>
                    <select id="planner-dish-select" onchange="toggleCustomDishInput(); calculatePortion();" class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3.5 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-600 transition-all-300">
                        <option value="capcay">Nasi Ayam Capcay & Apel (Standar Gizi MBG)</option>
                        <option value="taco">Chicken Salad Bowl & Jeruk (Diet Sehat / Pekerja)</option>
                        <option value="seblak">Soto Ayam Padat Nutrisi & Pisang (Massal / Hajatan)</option>
                        <option value="custom">✍️ Tulis Hidangan Sendiri (Input Manual)...</option>
                    </select>

                    <!-- Manual Input Field (Shown conditionally based on selection) -->
                    <div id="custom-dish-input-container" class="hidden mt-3 space-y-1.5">
                        <label class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider block">Tulis Hidangan Pilihan Anda</label>
                        <input type="text" id="planner-custom-dish" placeholder="Ketik resep kustom (misal: Nasi Rendang Daging & Melon)..." oninput="calculatePortion()" class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3.5 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-emerald-600 transition-all-300">
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <label class="text-xs font-extrabold text-slate-500 uppercase tracking-wider block">2. Tentukan Jumlah Porsi</label>
                        <span id="portion-value-display" class="text-sm font-black text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100">500 Porsi</span>
                    </div>
                    <input type="range" id="portion-range" min="10" max="2000" value="500" step="10" oninput="updatePortionSlider(this.value)" class="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-emerald-600">
                    <div class="flex justify-between text-[10px] text-slate-400 font-bold">
                        <span>10 Porsi</span>
                        <span>1,000 Porsi</span>
                        <span>2,000 Porsi</span>
                    </div>
                </div>

                <!-- Budget Optimizer Switch -->
                <div class="flex items-center justify-between p-3 bg-emerald-50/50 rounded-2xl border border-emerald-100/30">
                    <div class="flex gap-2 items-center">
                        <i class="fa-solid fa-coins text-emerald-600 text-sm"></i>
                        <div>
                            <p class="text-xs font-bold text-slate-800">Optimasi Anggaran AI</p>
                            <p class="text-[9px] text-slate-500">Rekomendasikan bahan pangan lokal termurah</p>
                        </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="budget-toggle" checked onchange="calculatePortion()" class="sr-only peer">
                        <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
                    </label>
                </div>
            </div>

            <!-- Interactive Outputs Card -->
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-extrabold text-slate-400 tracking-wider uppercase">Estimasi Kebutuhan Bahan Baku</h3>
                    <!-- AI Generated indicator added dynamically -->
                    <div class="flex items-center gap-1.5" id="ai-badge-status">
                        <span class="bg-emerald-100 text-emerald-800 text-[9px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles text-emerald-600"></i> AI Generated
                        </span>
                        <span class="text-[10px] text-emerald-700 font-bold flex items-center gap-1"><i class="fa-solid fa-shield-halved"></i> Gizi Seimbang</span>
                    </div>
                </div>

                <!-- Dynamic Ingredients Card -->
                <div class="bg-white border border-slate-100 rounded-3xl p-4 shadow-sm space-y-3">
                    <div id="ingredients-container" class="space-y-2.5">
                        <!-- Filled by JS -->
                    </div>

                    <div class="border-t border-slate-100 pt-3 flex justify-between items-center">
                        <div>
                            <span class="text-[9px] text-slate-400 font-bold block">ESTIMASI TOTAL BIAYA</span>
                            <span id="total-price-display" class="text-base font-extrabold text-emerald-800">Rp 7.500.000</span>
                        </div>
                        <button onclick="matchFarmersDirectly()" class="bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-all-300 flex items-center gap-1.5 shadow-sm">
                            <i class="fa-solid fa-cart-shopping"></i> Hubungkan Petani Lokal
                        </button>
                    </div>
                </div>
            </div>
        </section>


        <!-- SCREEN 3: AI HACCP SCANNER -->
        <section id="screen-haccp" class="hidden p-4 space-y-5">
            <!-- Header -->
            <div class="flex items-center gap-2">
                <button onclick="switchTab('home')" class="p-2 bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-full transition-all-300">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <div>
                    <h2 class="text-xl font-extrabold text-slate-800 leading-tight">AI HACCP Photo Scanner</h2>
                    <p class="text-xs text-slate-500">Uji higienis dapur, kesiapan saji & bahaya wadah</p>
                </div>
            </div>

            <!-- Simulated Camera Viewfinder -->
            <div class="bg-slate-900 rounded-3xl overflow-hidden shadow-xl aspect-video relative flex flex-col items-center justify-center group">
                <!-- Camera Backdrop Simulation -->
                <img id="haccp-camera-img" src="https://placehold.co/600x350/111827/ffffff?text=Pilih+Kondisi+Analisis+Di+Bawah" alt="Camera View" class="w-full h-full object-cover">
                
                <!-- Bounding Box Overlays (Controlled by JS) -->
                <div id="haccp-bounding-box" class="hidden absolute border-2 border-red-500 rounded-xl p-2 animate-pulse" style="top: 25%; left: 30%; width: 40%; height: 50%;">
                    <span id="haccp-bounding-tag" class="absolute -top-6 left-0 bg-red-600 text-[10px] text-white font-black px-2 py-0.5 rounded shadow">BAHAYA: STYROFOAM DETECTED</span>
                </div>

                <!-- Green Bounding Box Overlay -->
                <div id="haccp-bounding-box-safe" class="hidden absolute border-2 border-emerald-500 rounded-xl p-2 animate-pulse" style="top: 20%; left: 25%; width: 50%; height: 60%;">
                    <span id="haccp-bounding-tag-safe" class="absolute -top-6 left-0 bg-emerald-600 text-[10px] text-white font-black px-2 py-0.5 rounded shadow">AMAN: FOOD GRADE STAINLESS</span>
                </div>

                <!-- Camera Overlay UI elements -->
                <div class="absolute top-3 left-3 flex gap-1.5">
                    <span class="text-[9px] bg-black/60 backdrop-blur-sm text-white font-bold px-2 py-1 rounded-full flex items-center gap-1"><span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-ping"></span> LIVE CAMERA</span>
                </div>
                <div class="absolute bottom-3 right-3">
                    <span class="text-[9px] bg-black/60 backdrop-blur-sm text-white font-mono px-2 py-1 rounded">ISO 400</span>
                </div>
            </div>

            <!-- Choose presets to simulate scanning -->
            <div class="space-y-2">
                <label class="text-xs font-extrabold text-slate-400 uppercase tracking-wider block">Pilih Simulasi Objek Scan:</label>
                <div class="grid grid-cols-2 gap-2">
                    <button onclick="simulateHACCP('styrofoam')" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold py-2.5 px-3 rounded-2xl transition-all-300 text-left flex items-center gap-2">
                        <span class="w-3 h-3 bg-red-500 rounded-full"></span> Kuah Styrofoam (Panas)
                    </button>
                    <button onclick="simulateHACCP('plastic')" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold py-2.5 px-3 rounded-2xl transition-all-300 text-left flex items-center gap-2">
                        <span class="w-3 h-3 bg-red-500 rounded-full"></span> Kresek Panas Warmindo
                    </button>
                    <button onclick="simulateHACCP('stainless')" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold py-2.5 px-3 rounded-2xl transition-all-300 text-left flex items-center gap-2">
                        <span class="w-3 h-3 bg-emerald-500 rounded-full"></span> Wadah Stainless Steel
                    </button>
                    <button onclick="simulateHACCP('dirty')" class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 text-xs font-bold py-2.5 px-3 rounded-2xl transition-all-300 text-left flex items-center gap-2">
                        <span class="w-3 h-3 bg-amber-500 rounded-full"></span> Meja Dapur Kotor
                    </button>
                </div>
